#
# This file MUST be edited with the 'visudo' command as root.
#
# You should add this file as local content in /etc/sudoers.d/
# The file should be readable only by root and the root group
# It should not be writable (that's what visudo is for!)
#
# See the man page for details on how to write a sudoers file.
#

# Allow the sudoers group to run i{f,o}top with sudo, but without a password
# (You can make the sudo implicit if you alias iftop='sudo iftop')
# tulpn is different - I wrote it with a builtin sudo trampoline

Cmnd_Alias IO_MONITORING_TOOLS = /usr/sbin/iftop, /usr/sbin/iotop
%sudo ALL = (root) NOPASSWD: IO_MONITORING_TOOLS

%sudo ALL = (root) NOPASSWD: /usr/local/bin/tulpn
